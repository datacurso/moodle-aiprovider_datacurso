{{!
    @template aiprovider_datacurso/config_page

    Per-plugin rate limit configuration form.

    Example context (json):
    {
        "services": [
            {
                "sid": "local_assign_ai",
                "name": "Assign AI",
                "enable": true,
                "limit": 10,
                "windowvalue": 5,
                "creditperaction": 10,
                "units": [
                    {"value": "minutes", "label": "Minutes", "selected": true},
                    {"value": "hours", "label": "Hours", "selected": false},
                    {"value": "days", "label": "Days", "selected": false}
                ]
            }
        ]
    }
}}

<div data-region="aiprovider_datacurso/config-root">
    <div class="mb-4">
        <h3>{{#str}} config_heading, aiprovider_datacurso {{/str}}</h3>
        <p class="text-muted">{{#str}} config_desc, aiprovider_datacurso {{/str}}</p>
    </div>

    <form data-region="aiprovider_datacurso/ratelimit-form">
        {{#services}}
        <div class="card mb-3" data-service="{{sid}}">
            <div class="card-header">
                <h5 class="mb-0">{{name}}</h5>
            </div>
            <div class="card-body">
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="enable-{{sid}}"
                        data-field="enable" {{#enable}}checked{{/enable}}>
                    <label class="form-check-label" for="enable-{{sid}}">
                        {{#str}} ratelimit_enable, aiprovider_datacurso {{/str}}
                    </label>
                </div>

                <div class="form-row row">
                    <div class="form-group col-md-6">
                        <label for="limit-{{sid}}">{{#str}} ratelimit_limit, aiprovider_datacurso {{/str}}</label>
                        <input type="number" min="0" class="form-control" id="limit-{{sid}}"
                            data-field="limit" value="{{limit}}">
                    </div>

                    <div class="form-group col-md-6">
                        <label for="windowvalue-{{sid}}">{{#str}} ratelimit_window, aiprovider_datacurso {{/str}}</label>
                        <div class="input-group">
                            <input type="number" min="1" class="form-control" id="windowvalue-{{sid}}"
                                data-field="windowvalue" value="{{windowvalue}}">
                            <select class="custom-select" data-field="windowunit" aria-label="unit">
                                {{#units}}
                                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                {{/units}}
                            </select>
                        </div>
                    </div>
                </div>

                <div class="mt-2">
                    <label class="font-weight-bold">
                        {{#str}} ratelimit_creditperaction, aiprovider_datacurso {{/str}}
                    </label>
                    <small class="form-text text-muted mb-2">
                        {{#str}} ratelimit_creditperaction_desc, aiprovider_datacurso {{/str}}
                    </small>
                    <div class="form-row row">
                        {{#actions}}
                        <div class="form-group col-md-3">
                            <label for="cpa-{{sid}}-{{key}}">{{label}}</label>
                            <input type="number" min="0" class="form-control" id="cpa-{{sid}}-{{key}}"
                                data-actionkey="{{key}}" value="{{value}}">
                        </div>
                        {{/actions}}
                    </div>
                </div>
            </div>
        </div>
        {{/services}}

        <div class="mb-4">
            <button type="button" class="btn btn-primary" data-action="save-ratelimit-config">
                {{#str}} savechanges {{/str}}
            </button>
        </div>
    </form>
</div>
